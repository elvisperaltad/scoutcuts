[Unit]
Description=ScoutCuts: monitoreo periodico de salud con alerta al admin
# Revisa el proceso, nginx y la ruta publica /salud cada 5 minutos (ver el
# timer). Alerta por Telegram al administrador SOLO en la transicion de
# estado (ok->fallo o fallo->ok), nunca en cada corrida, para no inundar el
# chat. Sin SCOUTCUTS_TELEGRAM_ADMIN_ID configurado, el fallo igual queda
# en journalctl -u scoutcuts-monitor con prioridad err.
After=network.target scoutcuts.service

[Service]
Type=oneshot
User=cortador
Group=cortador
EnvironmentFile=/etc/cortador-control/app.env
WorkingDirectory=/opt/cortador-control/app
ExecStart=/bin/bash /opt/cortador-control/app/despliegue/monitor-salud.sh

# Mismo endurecimiento que el resto de unidades de este proyecto: solo
# puede tocar sus propios datos (el archivo de estado), nunca el resto del
# sistema, y solo hace peticiones de red salientes (curl a la propia API
# publica y a la API de Telegram).
ProtectSystem=strict
ReadWritePaths=/opt/cortador-control/datos
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
