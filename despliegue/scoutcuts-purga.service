[Unit]
Description=ScoutCuts: purga de trabajos vencidos (independiente de que lleguen subidas nuevas)
# La API ya llama a Almacen.purgar() en cada subida nueva, pero si el trafico
# bajo deja pasar muchas horas sin subidas, un trabajo con error o sin
# descargar podria quedar en disco mucho mas de max_edad_horas. Dado que hay
# menores de edad en el material, la purga no puede depender de que alguien
# suba un video: este timer la dispara igual todos los dias.
After=network.target

[Service]
Type=oneshot
User=cortador
Group=cortador
EnvironmentFile=/etc/cortador-control/app.env
WorkingDirectory=/opt/cortador-control/app
ExecStart=/opt/cortador-control/app/.venv/bin/python -c "import os; from cortador.servidor import almacen as alm; a = alm.Almacen(os.environ['SCOUTCUTS_DATOS']); list(a.purgar(float(os.environ.get('SCOUTCUTS_MAX_EDAD_HORAS', '24'))))"

# Mismo endurecimiento que el servicio principal: solo puede tocar sus
# propios datos, nunca el resto del sistema.
ProtectSystem=strict
ReadWritePaths=/opt/cortador-control/datos
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
